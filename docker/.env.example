# Copy to `.env` (this dir) and fill with real values. `.env` is gitignored.
# docker-compose reads these automatically.

# BitFinite node RPC — the mempool backend connects to bitfinited.
# Use the node's actual rpcuser/rpcpassword from bitfinite.conf.
CORE_RPC_USERNAME=your_rpc_user
CORE_RPC_PASSWORD=your_rpc_password

# The mempool's OWN MariaDB (separate from the node). Pick strong values —
# these are NOT the node credentials.
MEMPOOL_DB_NAME=mempool
MEMPOOL_DB_USER=mempool
MEMPOOL_DB_PASSWORD=change_me_to_a_strong_password
MEMPOOL_DB_ROOT_PASSWORD=change_me_to_a_strong_root_password
